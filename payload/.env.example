# Local (default): leave DATABASE_URL unset → uses payload/data/payload.db
# Staging/production (Neon):
# DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public URL of this Payload/Next app (set after first Vercel deploy)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SERVER_URL=

# Public Astro site URL (staging frontend)
FRONTEND_URL=http://localhost:4322

# Extra allowed origins (comma-separated), e.g. preview URLs
# CORS_ORIGINS=https://paradox-site-xxx.vercel.app

# Vercel Blob (required on Vercel for uploads to persist)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
