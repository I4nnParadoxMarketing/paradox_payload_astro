---
import Layout from '../layouts/Layout.astro'
---

<Layout title="Page Not Found - Paradox Marketing">
  <section class="not-found">
    <div class="container">
      <h1>Page not found</h1>
      <p>The page you're looking for doesn't exist in this replica yet.</p>
      <a href="/" class="btn-talk">Back to Home</a>
    </div>
  </section>
</Layout>

<style>
  .not-found {
    padding: 120px 20px;
    text-align: center;
  }
  .not-found h1 {
    font-size: 48px;
    margin-bottom: 16px;
  }
</style>
