---
import menuHtmlFallback from '../data/main-menu.html?raw'
import { getMainMenu, menuItemsToHtml } from '../lib/payload'
import '../styles/mmenu-custom.css'
import '../styles/header-mmenu.css'

interface Props {
  isHome?: boolean
}

const { isHome = false } = Astro.props

const menu = await getMainMenu()
const menuHtml =
  menu?.items?.length ? menuItemsToHtml(menu.items) : menuHtmlFallback
---

<header
  id="new-header"
  class:list={['header2026', { 'header-on-home': isHome }]}
>
  <div class="container">
    <div class="header-content">
      <div class="site-logo">
        <a href="/" class="logo-link">
          <img
            src="https://paradoxmarketing.io/wp-content/uploads/2026/03/footer-logo.png"
            alt="Paradox Marketing Logo"
            class="logo-img"
            width="180"
            height="50"
            decoding="async"
          />
        </a>
      </div>
      <Fragment set:html={menuHtml} />
      <style is:inline>
        #menu {
          visibility: hidden;
          opacity: 0;
          transition: opacity 0.2s ease;
        }
        .mm-wrapper #menu {
          visibility: visible;
          opacity: 1;
        }
      </style>
      <a href="#menu" id="menu-ham" aria-label="Paradox Marketing Toggle Menu" aria-controls="menu"><span></span></a>
    </div>
  </div>
</header>

<div class="header-spacer"></div>

<link
  rel="stylesheet"
  href="https://cdnjs.cloudflare.com/ajax/libs/jQuery.mmenu/9.3.0/mmenu.css"
/>
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/jQuery.mmenu/9.3.0/mmenu.js"
  defer
></script>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const header = document.getElementById('new-header')
    const scrollThreshold = 50

    if (header) {
      window.addEventListener(
        'scroll',
        () => {
          if (window.pageYOffset > scrollThreshold) {
            header.classList.add('scrolled')
          } else {
            header.classList.remove('scrolled')
          }
        },
        { passive: true },
      )
    }

    let attempts = 0
    const maxAttempts = 10
    const intervalMs = 2000
    let interval = null
    let initialized = false

    const cleanupMmenuDom = () => {
      // Only unwrap the page content — never the off-canvas blocker
      document.querySelectorAll('.mm-slideout.mm-page').forEach((el) => {
        if (!el.classList.contains('mm-blocker') && !el.classList.contains('mm-wrapper__blocker')) {
          el.classList.remove('mm-page')
        }
      })
      document.querySelector('.mm-wrapper #menu')?.classList.remove('mm-hidden')
      // Keep Let's Talk modal outside .mm-slideout so it can stack above the hero
      const letsTalk = document.getElementById('letsTalkModal')
      if (letsTalk && letsTalk.parentElement !== document.body) {
        document.body.appendChild(letsTalk)
      }
    }

    const handleMaxAttempts = () => {
      if (attempts >= maxAttempts && interval) {
        clearInterval(interval)
        console.warn('Mmenu init: max attempts reached.')
      }
    }

    const tryInit = () => {
      if (initialized) return true

      attempts++

      if (typeof Mmenu === 'undefined') {
        if (attempts < maxAttempts) {
          setTimeout(tryInit, 50)
        } else {
          handleMaxAttempts()
        }
        return false
      }

      const menuEl = document.querySelector('#menu')
      if (!menuEl) {
        handleMaxAttempts()
        return false
      }

      try {
        const m = new Mmenu('#menu', {
          extensions: ['fx-panels-slide', 'fx-listitems-slide', 'fx-listitems-drop'],
          slidingSubmenus: true,
          offCanvas: {
            position: 'right-front',
            effect: 'fx-listitems-drop',
          },
          theme: 'white',
          navbar: {
            title: '&nbsp;',
          },
          navbars: [
            {
              position: 'top',
              content: [
                "<p>From Complex Challenges To Simple Solutions</p><p>We've Got You Covered</p><button type='button' id='close-menu' aria-label='Close menu'></button>",
              ],
            },
            {
              position: 'top',
              content: ['prev', 'title'],
            },
            {
              position: 'bottom',
              content: ["<a href='/contact-us/' class='hero-btn-book-a-call'>Contact Us</a>"],
            },
          ],
        })

        const api = m.API

        m.bind('init:after', () => {
          document.body.classList.add('menu-loaded')
          cleanupMmenuDom()
        })

        // Delegated close — works even if navbar content is re-rendered
        document.addEventListener('click', (e) => {
          const target = e.target
          if (!(target instanceof Element)) return
          const closeBtn = target.closest('#close-menu')
          if (!closeBtn) return
          e.preventDefault()
          e.stopPropagation()
          api.close()
        })

        // Backdrop click should always close
        document.addEventListener('click', (e) => {
          const target = e.target
          if (!(target instanceof Element)) return
          if (target.closest('.mm-wrapper__blocker, .mm-blocker')) {
            api.close()
          }
        })

        // Escape key closes the drawer
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') api.close()
        })

        cleanupMmenuDom()
        initialized = true
        if (interval) clearInterval(interval)
        return true
      } catch (e) {
        console.error('Menu init failed:', e)
        handleMaxAttempts()
        return false
      }
    }

    if (!tryInit()) {
      interval = setInterval(tryInit, intervalMs)
    }
  })
</script>
