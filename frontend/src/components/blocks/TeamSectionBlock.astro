---
const {
  title = 'Our Leadership',
  leadershipIntro = '',
  leaders = [],
  teamSizeTitle = '',
  teamSizeDescription = '',
} = Astro.props
const leaderList = Array.isArray(leaders) ? leaders : []
---

<section class="team-section">
  <div class="container">
    <h2 class="section-title">{title}</h2>
    {leadershipIntro && <p class="team-section__intro">{leadershipIntro}</p>}
    <div class="leaders-grid">
      {leaderList.map((leader: { name: string; role: string; imageUrl?: string }) => (
        <div class="leader-card">
          <div class="leader-card__avatar">
            {leader.imageUrl ? (
              <img src={leader.imageUrl} alt={leader.name} loading="lazy" />
            ) : (
              <span>{leader.name.charAt(0)}</span>
            )}
          </div>
          <h3>{leader.name}</h3>
          <p>{leader.role}</p>
        </div>
      ))}
    </div>
    {(teamSizeTitle || teamSizeDescription) && (
      <div class="team-size-block">
        {teamSizeTitle && <h3>{teamSizeTitle}</h3>}
        {teamSizeDescription && <p>{teamSizeDescription}</p>}
      </div>
    )}
  </div>
</section>
