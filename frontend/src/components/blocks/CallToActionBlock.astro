---
const {
  heading = 'Considering hiring a consulting firm? Consult with one of our Trusted Advisors to discuss your business goals and needs.',
  ctaLabel = "Let's Talk",
  ctaUrl = 'https://hs.paradoxmarketing.io/meetings/paradoxmarketing/discovery-call',
} = Astro.props
---

<section class="call-to-action">
  <div class="container call-to-action-col">
    <h2 class="cta-heading">{heading}</h2>
    <div class="call-to-action__btn-wrap">
      <a
        class="call-to-action__btn btn-talk"
        href={ctaUrl || '#'}
        data-lets-talk
        data-bs-toggle="modal"
        data-bs-target="#letsTalkModal"
      >
        {ctaLabel}
      </a>
    </div>
  </div>
</section>
