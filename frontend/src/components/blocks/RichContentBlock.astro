---
import { absolutizePayloadMediaHtml } from '../../lib/mediaUrl'

const { eyebrow = '', title = '', bodyHtml = '' } = Astro.props
const html = absolutizePayloadMediaHtml(typeof bodyHtml === 'string' ? bodyHtml : '')
---

<section class="rich-content">
  <div class="container rich-content__inner">
    {eyebrow && <p class="rich-content__eyebrow">{eyebrow}</p>}
    {title && <h2 class="rich-content__title">{title}</h2>}
    <div class="rich-content__body" set:html={html} />
  </div>
</section>
