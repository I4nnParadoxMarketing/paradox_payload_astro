---
import '../styles/paradox.css'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'
import LetsTalkModal from '../components/LetsTalkModal.astro'

interface Props {
  title?: string
  description?: string
  isHome?: boolean
}

const {
  title = 'Paradox Marketing',
  description = 'Have Our Team Become YOUR Team',
  isHome = false,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" href="https://paradoxmarketing.io/wp-content/uploads/2025/02/FavIcon-180x180-1-150x150.png" />
  </head>
  <body class:list={['homepage-2026', { home: isHome }]}>
    <Header isHome={isHome} />
    <main id="content">
      <slot />
    </main>
    <Footer />
    <LetsTalkModal />
  </body>
</html>
